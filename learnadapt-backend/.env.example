# Copy this file to .env and fill in your own values. NEVER commit .env to GitHub.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too
DATABASE_URL=sqlite:///learnadapt.db
CORS_ORIGINS=*

# Leave ANTHROPIC_API_KEY empty to use the built-in demo generator (no AI calls)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# After a student submits, automatically create the next adaptation for teacher review
AUTO_ADAPT=true
